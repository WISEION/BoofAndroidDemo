<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- The BoofCV DisplayView gets added here by startCamera() -->
    <FrameLayout
        android:id="@+id/camera_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-left: histogram mode toggle -->
    <ImageButton
        android:id="@+id/btn_mode"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/btn_round"
        android:contentDescription="@string/cd_mode"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mode" />

    <!-- Top-right: settings -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_round"
        android:contentDescription="@string/cd_settings"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings" />

    <!-- Bottom-center: shutter -->
    <ImageButton
        android:id="@+id/btn_shutter"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_shutter"
        android:scaleType="fitCenter"
        android:src="@drawable/shutter_photo" />

    <!-- Recording indicator -->
    <TextView
        android:id="@+id/rec_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@color/scrim"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="● REC"
        android:textColor="#FF5252"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
